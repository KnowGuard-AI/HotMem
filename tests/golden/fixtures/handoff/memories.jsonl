{"content_hash":"f53fc206e40e4b461f3362d610c11609f11400374e862cf96f25ed08fd2bd5ee","created_at":"2026-09-16T11:00:00Z","fact_text":"HotMem handoff packages are hotmem-handoff-v1 directories holding a versioned manifest, an ordered session.jsonl stream, a bounded resume-brief.json, and memories.jsonl records in the existing hotmem-interchange-v1 format.","id":"9cd7d5bb180d13b830cdabef6dc91a89b40e13725e33542158f45ab09a3b7b35","identifier":"showcase/handoff-package-contract","importance":0.8,"memory_type":"fact","metadata":null,"provenance":{"handoff":{"adapter":"codex-export","adapter_version":"1","session_id":"sess-7f3a2b","session_time_range":{"ended_at":"2026-09-16T11:45:00Z","started_at":"2026-09-16T09:00:00Z"},"source_entry_id":"cx-012","source_seq":12}},"schema_version":1,"source":"handoff:codex-export","tags":["showcase","handoff"]}
